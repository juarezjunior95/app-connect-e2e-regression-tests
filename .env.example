# Copie para .env e preencha (nunca commite .env com segredos reais).
# Antes de correr o Robot:  source .env
#
# BrowserStack: username e access key em Account → Settings.
# URL do hub Appium:
export REMOTE_APPIUM_URL="https://SEU_USERNAME:SEU_ACCESS_KEY@hub-cloud.browserstack.com/wd/hub"
# Após upload do APK no BrowserStack (UI ou API):
export CLOUD_APP="bs://SUBSTITUA_PELO_ID_DA_APP"
# Dispositivo (alinhar com a lista do BrowserStack App Automate):
export DEVICE_NAME="Samsung Galaxy S24"
# Versão Android suportada pelo device (Capability Builder):
# https://www.browserstack.com/app-automate/capabilities — ex.: Galaxy S23 costuma usar 13.0
export PLATFORM_VERSION="14.0"

# Credenciais da aplicação (testes de login):
export TEST_USER_EMAIL="email.de.teste@empresa.com"
export TEST_USER_PASSWORD="sua_password_de_teste"

# Opcional: só para Appium local (deixe CLOUD_APP vazio e use o APK em apps/android/)
# export REMOTE_APPIUM_URL="http://127.0.0.1:4723/wd/hub"
# Descomente para ignorar app na nuvem e usar APK local:
# unset CLOUD_APP
